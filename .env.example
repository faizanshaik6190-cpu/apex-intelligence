# Apex Intelligence - Private Server Environment

# ⚠️ CHANGE THESE VALUES FOR PRODUCTION
SECRET_KEY=change-this-to-random-string-in-production
APEX_API_KEY=change-this-to-your-secure-api-key

# Database
DATABASE_URL=postgresql://apex_user:apex_secure_password_change_me@postgres:5432/apex_intelligence
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Server
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# Owner
OWNER_EMAIL=owner@apexintelligence.com
DEFAULT_MIN_PRICE=500
DEFAULT_MAX_PRICE=5000

# Integrations (Optional - leave blank if not using)
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Voice
VOICE_ENABLED=false
VOICE_PROVIDER=openai
